  "correction": [
    "Enable Linux orphan adoption before QProcess, start_owned_process, start_child and public CLI launch.",
    "Bind owned session processes to numeric PID, start ticks and pidfd; reject a reused root identity.",
    "Wait for captured processes to stop, rescan for children, terminate only captured pidfds, and reap only owned descendant pidfds.",
    "Observe the direct root pidfd without consuming its exit status; leave QProcess/Popen and unrelated children with their original wait owners.",
    "Keep ownership retryable after explicit cleanup failure; do not fall back to broad waitpid or sibling-child reaping."
  ],
  "runtime_prerequisites": [
    "Linux >=5.4 with permitted pidfd_open, pidfd_send_signal, waitid(P_PIDFD) and PR_SET_CHILD_SUBREAPER.",
    "A consistent procfs view of the process PID namespace; unsupported or denied primitives fail before owned launch."
  ],
  "scope_limits": [
    "Same-session owned descendants; escaped setsid sessions/cgroup containment are not newly qualified.",
    "Windows existing Job behavior is unchanged and was not rerun locally.",
    "Controlled zombie reproduction used a real Linux subreaper, not an actual local PID1 container.",
    "No full Docker or installed-default-user candidate acceptance is claimed by local Qt runs."
  ],
